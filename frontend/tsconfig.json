{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // ponytail: ปิดเฉพาะ noImplicitAny ในรอบย้าย JS→TS — param ที่ไม่ได้ประกาศชนิด
    // จะเป็น any เท่ากับตอนเป็น JS (ไม่ถอยหลัง) แต่ strictNullChecks ยังทำงานเต็ม
    // และ error เชิงโครงสร้าง (TS2339/2322/2345) ยังจับได้ทั้งหมด
    // อัปเกรด: เปิด true แล้วไล่ใส่ชนิดทีละโฟลเดอร์ (lib → models → controllers → app)
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }],
    // baseUrl ต้องมี — webpack ของ Next 14 อ่านค่านี้เพื่อ resolve alias "@/..."
    // (ถ้าไม่มี tsc ผ่านแต่ next build พังด้วย Module not found)
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
